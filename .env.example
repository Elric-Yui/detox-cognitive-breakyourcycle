# Copy this file to .env.local and fill in the values

# Whop plan ID (found in your Whop dashboard)
NEXT_PUBLIC_WHOP_PLAN_ID=plan_xxxxxxxxxxxxxxx

# Whop webhook secret (found in Whop dashboard → Webhooks)
WHOP_WEBHOOK_SECRET=whop_whs_xxxxxxxxxxxxxxx

# Public site URL (set this to your Netlify URL in production)
NEXT_PUBLIC_SITE_URL=https://your-site.netlify.app
